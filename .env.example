# LAXMI JEWELLERY — environment
#
# Copy to `.env` and fill in. Every value has a working default for local
# development, so an empty .env is fine to start with.

# ------------------------------------------------------------------ server
NODE_ENV=development
PORT=3001

# Where the SQLite file lives. Defaults to server/data/laxmi.db
# DATABASE_PATH=./server/data/laxmi.db

# Set to 1 when running behind nginx / a load balancer / a PaaS router.
# Without it, every visitor appears to come from the proxy's IP and shares one
# rate-limit bucket. Do NOT set it when nothing is in front of the server —
# a client could then forge X-Forwarded-For.
# TRUST_PROXY=1

# Origins allowed to make mutating requests (comma separated).
# In development the Vite proxy makes the browser's request same-origin, so this
# mostly matters if you call the API directly from another host.
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# -------------------------------------------------------------------- email
# Password-reset links are printed to the server console until this is set.
# Until then, /api/auth/forgot-password returns the link in its response in
# non-production builds only. Configure this BEFORE deploying.
# SMTP_URL=smtp://user:password@smtp.example.com:587

# ------------------------------------------------------------- rate limits
# Every limiter can be overridden with RATE_LIMIT_<NAME>. Names are the ones in
# the code: API, REGISTER, LOGIN_IP, LOGIN_ACCOUNT, FORGOT, RESET.
# Defaults are tuned for real visitors; the test suite raises two of them.
#
# RATE_LIMIT_REGISTER=5          # per hour, per IP
# RATE_LIMIT_LOGIN_IP=20         # per 15 min, per IP
# RATE_LIMIT_LOGIN_ACCOUNT=10    # per 15 min, per email address
#
# NOTE: this counter lives in the process. Behind more than one instance each
# instance keeps its own, so the effective limit is (limit x instances). Move
# the store in server/lib/rate-limit.js to Redis before scaling out.
